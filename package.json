{
  "name": "ai_hackathon_fresher",
  "version": "1.0.0",
  "description": "This repository is structured to support a hackathon prototype for an AI-powered IT helpdesk solution.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "backend:install": "python3 -m pip install -r backend/requirements.txt",
    "backend:dev": ". .venv/bin/activate && MONGODB_URI=${MONGODB_URI:-mongodb://127.0.0.1:27017} MONGODB_DB=${MONGODB_DB:-itsm_ai} python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --reload",
    "start": "npm run frontend:dev",
    "test": "echo \"No project tests configured yet.\""
  },
  "keywords": [],
